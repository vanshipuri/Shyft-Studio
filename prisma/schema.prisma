// Reference schema for Shyft Studio (documentation only).
//
// IMPORTANT: the runtime does NOT use Prisma — the app reads/writes SQLite through
// src/lib/db.mjs (better-sqlite3, explicit SQL). This file exists so the data model can
// be reviewed as a typed schema and kept in sync with the DDL in src/lib/db.mjs and
// src/scripts/seed.js. If you change the model here, mirror it in both of those files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SALES
  PRODUCTION
}

// Every stage has exactly one default owner role, enforced in app logic by
// src/lib/pipeline.mjs (ENQUIRY/QUOTED/DESIGN/DELIVERED → SALES,
// PRINTING/READY → PRODUCTION). Jobs are auto-reassigned to the stage owner
// on every transition and the handoff is written to Activity.
enum JobStage {
  ENQUIRY
  QUOTED
  DESIGN
  PRINTING
  READY
  DELIVERED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      Role
  password  String // simple demo auth (documented scope cut)
  createdAt DateTime @default(now())

  notes      Note[]
  activities Activity[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  jobs       Job[]
  notes      Note[]
  activities Activity[]
}

model Job {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  stage        JobStage @default(ENQUIRY)
  assignedToId Int?
  customerId   Int
  quoteAmount  Float?
  dueDate      DateTime?
  paidUpfront  Boolean  @default(false) // advance received = order confirmed
  priority     String   @default("normal") // low | normal | high | urgent
  notes        String?
  isLate       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leadSource   String   @default("Direct")
  specsSummary String? // canonical one-line spec, e.g. "500 Visiting Cards (300gsm Matte)"
  checklist    String? // JSON: 6 pre-flight tasks (proof, paper, print, finishing, QC)
  riskScore    String   @default("LOW") // LOW | MODERATE | HIGH | CRITICAL
  riskReason   String?

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes      Note[]
  activities Activity[]
}

// Free-text communication log (customer- and/or job-scoped).
model Note {
  id         Int      @id @default(autoincrement())
  content    String
  createdBy  Int
  customerId Int?
  jobId      Int?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Audit trail / JobStageHistory: every stage move, ownership handoff, checklist
// tick, and note, with user + timestamp.
model Activity {
  id          Int      @id @default(autoincrement())
  description String
  byUserId    Int
  jobId       Int?
  customerId  Int?
  createdAt   DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
