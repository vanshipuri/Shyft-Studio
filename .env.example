# Shyft Studio — configuration reference
# Copy to .env and fill in only what you need. Everything here is OPTIONAL:
# the app runs fully offline with zero environment variables set.

# --- Database -------------------------------------------------------------
# better-sqlite3 file path. Defaults to ./db.sqlite in the project root.
# Set this in CI so tests never touch the committed demo database.
# DB_PATH=/tmp/shyft.sqlite

# Used only by prisma/schema.prisma, which is kept as documentation —
# the runtime uses better-sqlite3 with explicit SQL (see src/lib/db.mjs).
# DATABASE_URL="file:./db.sqlite"

# --- Optional LLM provider (intake enrichment) ----------------------------
# Leave unset and the intake parser runs on the deterministic rules engine
# only — no network calls, identical behaviour. Set a key to let a provider
# fill the gaps the rules engine leaves blank (it can never set prices).
#
# Any OpenAI-compatible endpoint works: OpenAI, Groq, Together, vLLM, Ollama.
# SHYFT_LLM_API_KEY=sk-...
# SHYFT_LLM_BASE_URL=https://api.openai.com/v1
# SHYFT_LLM_MODEL=gpt-4o-mini
